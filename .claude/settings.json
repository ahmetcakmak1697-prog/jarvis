{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read --strict"
          }
        ]
      }
    ]
  },
  "env": {
    "DO_NOT_TRACK": "1",
    "IMPECCABLE_NO_TELEMETRY": "1"
  }
}
