# ═══════════════════════════════════════════════════════
#  JARVIS — Ortam Değişkenleri
#  Bu dosyayı .env olarak kopyala: cp .env.example .env
# ═══════════════════════════════════════════════════════

# Claude API anahtarı (zorunlu)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Jarvis kişiliği
JARVIS_NAME=Jarvis
JARVIS_LANGUAGE=tr          # tr | en
JARVIS_MODEL=claude-opus-4-5-20251101

# Proje klasörü (RAG için taranacak)
PROJECT_PATH=./             # Varsayılan: mevcut klasör

# Bellek ayarları
MEMORY_PROVIDER=local       # local | qdrant
QDRANT_URL=http://localhost:6333   # MEMORY_PROVIDER=qdrant ise

# Ses ayarları
VOICE_ENABLED=false         # true yapınca ses aktif
WHISPER_MODEL=base          # tiny | base | small | medium | large
TTS_VOICE=tr-TR-AhmetNeural # Edge TTS sesi (Türkçe erkek)
# TTS_VOICE=tr-TR-EmelNeural # Türkçe kadın sesi

# Ajan ayarları
MAX_AGENT_ITERATIONS=10     # Sonsuz döngü önlemi
AUTO_RUN_COMMANDS=false     # true: onay sormadan çalıştır (dikkatli!)

# D2 Web Research (AssistantExecutor path)
# JARVIS_WEB_RESEARCH_ENABLED=1  # Etkinleştirir: WebResearchPolicy + WebResearcher
JARVIS_WEB_RESEARCH_ENABLED=0    # Varsayılan: kapalı (live web yok)

# E1 Proactive Policy
JARVIS_PROACTIVE_ENABLED=0    # default-off, enables future proactive delivery policy only; no auto-send unless explicitly wired later

# Security
JARVIS_PASSWORD_HASH=pbkdf2_sha256$300000$CHANGE_ME_SALT$CHANGE_ME_DIGEST
JARVIS_SESSION_SECRET=CHANGE_ME_WITH_SETUP_PASSWORD
