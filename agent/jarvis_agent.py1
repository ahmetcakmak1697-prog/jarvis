"""
jarvis/agent/jarvis_agent.py
─────────────────────────────────────────────────────────
ADIM 4 — Ajan Döngüsü

ReAct (Reason + Act) döngüsü:
  1. Kullanıcı mesajını al
  2. Bellek bağlamını yükle
  3. RAG ile ilgili kod parçalarını çek
  4. Claude'a araçlarla birlikte gönder
  5. Araç kullanımı varsa çalıştır → tekrarla
  6. Son yanıtı döndür
"""
from __future__ import annotations

import anthropic
import httpx
from rich.console import Console
from rich.markdown import Markdown
from rich.panel import Panel
from rich.spinner import Spinner

from config import (
    ANTHROPIC_API_KEY, JARVIS_MODEL, JARVIS_NAME,
    SYSTEM_PROMPT, MAX_AGENT_ITERATIONS
)
from memory.memory_manager import MemoryManager
from rag.indexer import RAGIndexer
from tools.tools import TOOL_DEFINITIONS, execute_tool

console = Console()


class JarvisAgent:
    """
    Kullanım:
        agent = JarvisAgent()
        response = agent.chat("main.py'deki hataları bul")
    """
    def __init__(self, with_memory: bool = True, with_rag: bool = True):
        self.client  = anthropic.Anthropic(api_key=ANTHROPIC_API_KEY, http_client=httpx.Client(verify=False))
        self.history: list[dict] = []   # Konuşma geçmişi

        # Bellek
        self.memory = MemoryManager() if with_memory else None

        # RAG
        if with_rag:
            try:
                self.rag = RAGIndexer()
                if self.rag.count == 0:
                    console.print("[yellow]RAG veritabanı boş. 'jarvis index' ile projeyi indeksle.[/]")
                else:
                    console.print(f"[green]RAG aktif: {self.rag.count} chunk yüklendi ✓[/]")
            except Exception:
                self.rag = None
                console.print("[yellow]RAG başlatılamadı (chromadb kurulu değil?).[/]")
        else:
            self.rag = None

    # ────────────────────────────────────────────────────
    def chat(self, user_message: str) -> str:
        """Ana giriş noktası. Kullanıcı mesajını işler ve yanıt döndürür."""
        # 1. Konuşma geçmişine ekle
        self.history.append({"role": "user", "content": user_message})

        # 2. System prompt'u bellek + RAG ile zenginleştir
        system = self._build_system(user_message)

        # 3. Ajan döngüsünü başlat
        response = self._run_loop(system)

        # 4. Belleğe kaydet
        if self.memory:
            self.memory.add(self.history[-6:])   # Son 3 tur

        return response

    # ────────────────────────────────────────────────────
    def _build_system(self, query: str) -> str:
        """Bellek + RAG bağlamını system prompt'a ekler."""
        system = SYSTEM_PROMPT

        # Bellek
        if self.memory:
            ctx = self.memory.get_context(query)
            if ctx:
                system += f"\n\n{ctx}"

        # RAG
        if self.rag:
            ctx = self.rag.format_context(query, n=4)
            if ctx:
                system += f"\n\n{ctx}"

        return system

    # ────────────────────────────────────────────────────
    def _run_loop(self, system: str) -> str:
        """
        ReAct döngüsü: Claude araç çağrırsa çalıştır → tekrar gönder.
        MAX_AGENT_ITERATIONS'a ulaşınca durur.
        """
        messages = list(self.history)   # Kopyala (geçmişi bozmamak için)

        for iteration in range(MAX_AGENT_ITERATIONS):
            with console.status(f"[cyan]{JARVIS_NAME} düşünüyor...[/]"):
                response = self.client.messages.create(
                    model=JARVIS_MODEL,
                    max_tokens=4096,
                    system=system,
                    tools=TOOL_DEFINITIONS,
                    messages=messages,
                )

            # Araç kullanımı yok → döngüyü bitir
            if response.stop_reason == "end_turn":
                text = self._extract_text(response)
                self.history.append({"role": "assistant", "content": text})
                return text

            # Araç kullanımı var
            if response.stop_reason == "tool_use":
                # Asistan mesajını geçmişe ekle
                messages.append({
                    "role": "assistant",
                    "content": response.content,
                })

                # Her araç çağrısını işle
                tool_results = []
                for block in response.content:
                    if block.type == "tool_use":
                        console.print(f"[dim]🔧 {block.name}({block.input})[/]")
                        result = execute_tool(block.name, block.input)
                        tool_results.append({
                            "type":        "tool_result",
                            "tool_use_id": block.id,
                            "content":     result,
                        })

                messages.append({"role": "user", "content": tool_results})
                continue

            # Beklenmedik stop reason
            break

        return "Maksimum iterasyon sınırına ulaşıldı."

    # ────────────────────────────────────────────────────
    @staticmethod
    def _extract_text(response) -> str:
        """Yanıttan metin bloklarını birleştirir."""
        return "\n".join(
            block.text for block in response.content
            if hasattr(block, "text")
        )

    def clear_history(self):
        """Konuşma geçmişini sıfırlar (bellek korunur)."""
        self.history = []
        console.print("[dim]Konuşma geçmişi temizlendi.[/]")
